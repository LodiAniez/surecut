<Window x:Class="SureCut.Windows.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SureCut favorites"
        WindowStyle="None" AllowsTransparency="False" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        SizeToContent="Manual" Width="56" Height="60" WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyboardNavigation.TabNavigation="Cycle">

  <Border x:Name="Surface" Background="Transparent" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0"
          CornerRadius="8" Padding="6" RenderTransformOrigin="1,1">
    <Border.RenderTransform>
      <ScaleTransform x:Name="OpenScale" ScaleX="1" ScaleY="1"/>
    </Border.RenderTransform>

    <StackPanel x:Name="Stack" Orientation="Vertical">

      <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    PanningMode="VerticalOnly" Focusable="False">
        <ScrollViewer.Resources>
          <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBarStyle}"/>
        </ScrollViewer.Resources>
        <StackPanel x:Name="Items" Orientation="Vertical"/>
      </ScrollViewer>

      <!-- MENU-13 empty state -->
      <StackPanel x:Name="EmptyState" Visibility="Collapsed" Margin="2,4,2,2" MaxWidth="72">
        <TextBlock Text="No favorites yet" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
        <Button x:Name="EmptyAddButton" Style="{StaticResource LinkButtonStyle}" Click="OnAddProgram">
          <TextBlock Text="Add a program…" TextWrapping="Wrap" TextAlignment="Center"/>
        </Button>
      </StackPanel>

      <!-- MENU-3 -->
      <Button x:Name="MoreButton" Style="{StaticResource LinkButtonStyle}" Content="Show more" Margin="0,2,0,0" Click="OnToggleMore"/>

      <!-- MENU-10 -->
      <Button x:Name="GearButton" Style="{StaticResource GearButtonStyle}" Margin="0,2,0,0" ToolTip="Settings" Click="OnGear"
              AutomationProperties.Name="Settings">
        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
              StrokeThickness="1.4" StrokeLineJoin="Round"
              Data="M8,5.8 A2.2,2.2 0 1 0 8,10.2 A2.2,2.2 0 1 0 8,5.8 Z M8,1.8 V3.5 M8,12.5 V14.2 M1.8,8 H3.5 M12.5,8 H14.2 M3.6,3.6 L4.8,4.8 M11.2,11.2 L12.4,12.4 M12.4,3.6 L11.2,4.8 M4.8,11.2 L3.6,12.4"/>
      </Button>
    </StackPanel>
  </Border>
</Window>
