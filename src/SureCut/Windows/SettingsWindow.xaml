<Window x:Class="SureCut.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SureCut settings"
        WindowStyle="None" AllowsTransparency="False" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="True" Topmost="True"
        SizeToContent="Manual" Width="300" Height="400" WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <Window.Resources>
    <Style x:Key="RowStyle" TargetType="Grid">
      <Setter Property="Margin" Value="0,7"/>
    </Style>
    <Style x:Key="RowLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style x:Key="RowHint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    </Style>
    <Style x:Key="RowDivider" TargetType="Border">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="{DynamicResource StrokeBrush}"/>
    </Style>
  </Window.Resources>

  <Border x:Name="Surface" Background="Transparent" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0" CornerRadius="8" Padding="14,12,14,14">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ScrollViewer.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBarStyle}"/>
      </ScrollViewer.Resources>
      <StackPanel>
        <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>

        <!-- SET-2 -->
        <Grid Style="{StaticResource RowStyle}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource RowLabel}" Text="Hide button when a program is launched"/>
            <TextBlock Style="{StaticResource RowHint}" Text="Off by default. When on, the button hides once the program's window appears and comes back when that window closes."/>
          </StackPanel>
          <ToggleButton x:Name="HideSwitch" Grid.Column="1" Style="{StaticResource SwitchStyle}" Margin="12,2,0,0" VerticalAlignment="Top"
                        AutomationProperties.Name="Hide button when a program is launched" Click="OnHideSwitch"/>
        </Grid>
        <Border Style="{StaticResource RowDivider}"/>

        <!-- SET-3a -->
        <Grid Style="{StaticResource RowStyle}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource RowLabel}" Text="Show or hide with a shortcut"/>
            <TextBlock Style="{StaticResource RowHint}" Text="Also opens the menu for keyboard use."/>
            <TextBlock x:Name="HotkeyWarning" Style="{StaticResource RowHint}" Foreground="{DynamicResource DangerBrush}"
                       Text="This shortcut is in use by another program." Visibility="Collapsed"/>
          </StackPanel>
          <Button x:Name="HotkeyButton" Grid.Column="1" Style="{StaticResource FlatButtonStyle}" Margin="12,1,0,0" VerticalAlignment="Top"
                  MinWidth="96" Content="Ctrl + Alt + Space" Click="OnHotkeyClick" LostKeyboardFocus="OnHotkeyLostFocus"
                  AutomationProperties.Name="Keyboard shortcut"/>
        </Grid>
        <Border Style="{StaticResource RowDivider}"/>

        <!-- SET-4 -->
        <Grid Style="{StaticResource RowStyle}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource RowLabel}" Text="Start with Windows" VerticalAlignment="Center"/>
          <ToggleButton x:Name="StartSwitch" Grid.Column="1" Style="{StaticResource SwitchStyle}" Margin="12,0,0,0"
                        AutomationProperties.Name="Start with Windows" Click="OnStartSwitch"/>
        </Grid>
        <Border Style="{StaticResource RowDivider}"/>

        <!-- SET-5 -->
        <Grid Style="{StaticResource RowStyle}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource RowLabel}" Text="Button size" VerticalAlignment="Center"/>
          <Border Grid.Column="1" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="6" Margin="12,0,0,0" ClipToBounds="True">
            <Border.Clip>
              <RectangleGeometry Rect="0,0,168,24" RadiusX="6" RadiusY="6"/>
            </Border.Clip>
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="SizeSmall" GroupName="Size" Style="{StaticResource SegmentStyle}" Content="Small" Tag="small" Checked="OnSizeChecked"/>
              <Border Width="1" Background="{DynamicResource StrokeBrush}"/>
              <RadioButton x:Name="SizeMedium" GroupName="Size" Style="{StaticResource SegmentStyle}" Content="Medium" Tag="medium" Checked="OnSizeChecked"/>
              <Border Width="1" Background="{DynamicResource StrokeBrush}"/>
              <RadioButton x:Name="SizeLarge" GroupName="Size" Style="{StaticResource SegmentStyle}" Content="Large" Tag="large" Checked="OnSizeChecked"/>
            </StackPanel>
          </Border>
        </Grid>
        <Border Style="{StaticResource RowDivider}"/>

        <!-- SET-6 -->
        <Grid Style="{StaticResource RowStyle}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource RowLabel}" Text="Button position"/>
            <TextBlock Style="{StaticResource RowHint}" Text="Move the button by holding it, then dragging."/>
          </StackPanel>
          <Button Grid.Column="1" Style="{StaticResource FlatButtonStyle}" Content="Reset position" Margin="12,1,0,0" VerticalAlignment="Top" Click="OnResetPosition"/>
        </Grid>

        <!-- SET-7 -->
        <TextBlock Text="Favorites" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,6"/>
        <StackPanel x:Name="FavRows"/>
        <TextBlock x:Name="FavEmpty" Style="{StaticResource RowHint}" Margin="2,4" Visibility="Collapsed"
                   Text="Nothing here yet. Add a program below or drop a shortcut on the button."/>
        <Button Style="{StaticResource AddButtonStyle}" Content="＋ Add a program…" Margin="0,6,0,0" HorizontalAlignment="Stretch" Click="OnAddProgram"/>
      </StackPanel>
    </ScrollViewer>
  </Border>
</Window>
